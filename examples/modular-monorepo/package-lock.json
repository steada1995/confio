{
  "name": "modular-monorepo-example",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "modular-monorepo-example",
      "workspaces": [
        "apps/*"
      ],
      "dependencies": {
        "confio": "file:../.."
      }
    },
    "../..": {
      "name": "confio",
      "version": "1.0.0",
      "license": "MIT",
      "engines": {
        "node": ">=18"
      }
    },
    "apps/api": {
      "dependencies": {
        "confio": "file:../../../.."
      }
    },
    "apps/worker": {
      "dependencies": {
        "confio": "file:../../../.."
      }
    },
    "node_modules/api": {
      "resolved": "apps/api",
      "link": true
    },
    "node_modules/confio": {
      "resolved": "../..",
      "link": true
    },
    "node_modules/worker": {
      "resolved": "apps/worker",
      "link": true
    }
  }
}
